{
  "name": "kyruma-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:foundation": "tsc -p tsconfig.foundation-tests.json && node --test .foundation-test-build/features/identity/domain/authorization.test.js .foundation-test-build/features/partner-context/application/partnerContext.test.js .foundation-test-build/features/partner-context/application/organizationContext.test.js",
    "test:lead-lifecycle": "tsc -p tsconfig.lead-lifecycle-tests.json && node --test .lead-lifecycle-test-build/features/lead-lifecycle/domain/lead.test.js .lead-lifecycle-test-build/features/lead-lifecycle/application/useCases.test.js .lead-lifecycle-test-build/features/lead-lifecycle/application/completionUseCases.test.js .lead-lifecycle-test-build/features/lead-lifecycle/api/controller.test.js",
    "test:lead-persistence": "set -a; . ./.env.local; set +a; DATABASE_URL=\"$TEST_DATABASE_URL\" tsc -p tsconfig.lead-persistence-tests.json && DATABASE_URL=\"$TEST_DATABASE_URL\" node --test .lead-persistence-test-build/features/lead-lifecycle/infrastructure/persistence/prisma.integration.test.js",
    "test:intelligence-persistence": "set -a; . ./.env.local; set +a; DATABASE_URL=\"$TEST_DATABASE_URL\" tsc -p tsconfig.intelligence-persistence-tests.json && DATABASE_URL=\"$TEST_DATABASE_URL\" node --test .intelligence-persistence-test-build/features/discovery-intelligence/infrastructure/persistence/prisma.integration.test.js",
    "test:discovery-intelligence": "tsc -p tsconfig.discovery-intelligence-tests.json && node --test .discovery-intelligence-test-build/features/discovery-intelligence/domain/*.test.js .discovery-intelligence-test-build/features/discovery-intelligence/infrastructure/persistence/persistence.test.js"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@next/third-parties": "16.2.11",
    "@prisma/client": "^6.19.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.43.0",
    "next": "16.2.11",
    "prisma": "^6.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.22"
    }
  }
}
