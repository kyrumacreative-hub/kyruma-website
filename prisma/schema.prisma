generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id               String          @id
  organizationId   String
  ownerId          String
  primaryContactId String
  origin           String
  status           String
  createdAt        DateTime
  createdBy        String
  archivedAt       DateTime?
  archivedBy       String?
  archiveReason    String?
  ownerships       Ownership[]
  qualifications   Qualification[]
}

model Ownership {
  id         String   @id
  leadId     String
  ownerId    String
  assignedBy String
  assignedAt DateTime
  reason     String?
  active     Boolean
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId])
}

model Qualification {
  id        String   @id
  leadId    String
  decision  String
  reason    String
  decidedBy String
  decidedAt DateTime
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, decidedAt])
}

model IntelligenceSnapshot {
  id                     String                 @id
  discoverySubmissionId  String
  submissionVersion      Int
  scopeType              String
  organizationId         String
  partnerId              String?
  workspaceId            String?
  contentHash            String
  classification         String
  retentionPolicyVersion String
  createdAt              DateTime
  payload                Json
  analyses               IntelligenceAnalysis[]

  @@unique([discoverySubmissionId, submissionVersion])
  @@index([organizationId, createdAt])
}

model IntelligenceAnalysis {
  id                         String               @id
  sourceSnapshotId           String
  discoverySubmissionId      String
  discoverySubmissionVersion Int
  analysisVersion            Int
  status                     String
  modelReference             String
  modelRunId                 String?
  promptTemplateVersion      Int
  policyVersion              String
  requestedBy                String
  requestedAt                DateTime
  generatedAt                DateTime?
  failedAt                   DateTime?
  archivedAt                 DateTime?
  confidence                 Float?
  correlationId              String
  snapshot                   IntelligenceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)

  @@unique([sourceSnapshotId, analysisVersion])
  @@unique([sourceSnapshotId, correlationId])
  @@index([discoverySubmissionId, analysisVersion])
}

model Partner {
  id                       String              @id
  code                     String              @unique
  leadId                   String              @unique
  organizationId           String
  primaryWorkspaceId       String              @unique
  initialOwnerMembershipId String              @unique
  status                   String
  correlationId            String?             @unique
  createdAt                DateTime
  workspaces               PartnerWorkspace[]
  memberships              PartnerMembership[]
}

model PartnerCodeSequence {
  id        Int @id @default(1)
  nextValue Int
}

model PartnerWorkspace {
  id        String  @id
  partnerId String
  primary   Boolean
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
}

model PartnerMembership {
  id        String  @id
  partnerId String
  role      String
  status    String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([partnerId, role])
}

model PartnerCreationIdempotency {
  correlationId String   @id
  partnerId     String   @unique
  createdAt     DateTime
}

model Workspace {
  id                       String                @id
  partnerId                String
  organizationId           String
  name                     String
  primary                  Boolean
  status                   String
  initialOwnerMemberId     String                @unique
  initialOwnerMembershipId String                @unique
  settingsVersion          Int
  createdAt                DateTime
  correlationId            String                @unique
  members                  WorkspaceMember[]
  invitations              WorkspaceInvitation[]
  settings                 WorkspaceSettings?

  @@index([partnerId])
  @@index([organizationId])
}

model WorkspaceMember {
  id           String    @id
  workspaceId  String
  membershipId String
  owner        Boolean
  status       String
  joinedAt     DateTime
  removedAt    DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, membershipId])
  @@index([workspaceId])
}

model WorkspaceInvitation {
  id                 String    @id
  workspaceId        String
  recipientReference String
  intendedRole       String
  tokenHash          String    @unique
  expiresAt          DateTime
  status             String
  createdAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  correlationId      String    @unique
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
}

model WorkspaceSettings {
  workspaceId String    @id
  version     Int
  values      Json
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
}

model Project {
  id             String   @id
  organizationId String
  partnerId      String
  workspaceId    String
  name           String
  status         String
  createdAt      DateTime
  createdBy      String
  correlationId  String   @unique

  @@index([organizationId])
  @@index([workspaceId])
}

model ProjectDocumentReference {
  id                String   @id
  projectId         String   @unique
  organizationId    String
  partnerId         String
  workspaceId       String
  provider          String
  externalReference String?  @unique
  externalUrl       String?
  idempotencyKey    String   @unique
  status            String
  lastError         String?
  attemptCount      Int
  createdAt         DateTime
  updatedAt         DateTime

  @@index([organizationId, workspaceId])
  @@index([partnerId])
}

model EventOutbox {
  eventId        String                  @id
  eventType      String
  eventVersion   Int
  organizationId String
  aggregateType  String
  aggregateId    String
  correlationId  String
  causationId    String?
  envelope       Json
  status         String
  availableAt    DateTime
  createdAt      DateTime
  dispatchedAt   DateTime?
  lockedAt       DateTime?
  lockOwner      String?
  deliveries     EventProcessingRecord[]

  @@index([status, availableAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([correlationId])
}

model EventProcessingRecord {
  id             String      @id
  eventId        String
  consumer       String
  handler        String
  status         String
  attemptCount   Int         @default(0)
  reprocessCount Int         @default(0)
  firstAttemptAt DateTime?
  lastAttemptAt  DateTime?
  processedAt    DateTime?
  nextRetryAt    DateTime?
  errorCode      String?
  errorMessage   String?
  lockedAt       DateTime?
  lockOwner      String?
  createdAt      DateTime
  updatedAt      DateTime
  event          EventOutbox @relation(fields: [eventId], references: [eventId], onDelete: Restrict)

  @@unique([eventId, consumer, handler])
  @@index([status, nextRetryAt, createdAt])
  @@index([eventId, status])
}
