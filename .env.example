# Client-side identifiers. Scripts load only after analytics consent.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kyrumacreative/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/kyruma/
NEXT_PUBLIC_TIKTOK_URL=

# Server-side values. Never expose these with a NEXT_PUBLIC_ prefix.
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=
META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=

# Clerk identity provider. Configure through the Vercel Marketplace before enabling access.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ACCESS_INVITATION_TOKEN_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/access/accept

# PostgreSQL connection for server-side KYRUMA OS persistence. Never expose publicly.
DATABASE_URL=

# Isolated PostgreSQL database used by destructive integration suites. Never point this at production.
TEST_DATABASE_URL=

# Google Drive canonical Project folder integration. Keep server-side only.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Comma-separated KYRUMA internal accounts allowed to operate the access control entry point.
# Server-side only. Never expose with NEXT_PUBLIC_.
KYRUMA_INTERNAL_ADMIN_EMAILS=
NEXT_PUBLIC_APP_URL=
